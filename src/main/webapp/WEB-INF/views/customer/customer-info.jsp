<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><fmt:setLocale value="vi_VN"/>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Thông tin khách hàng | Light Ticket</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/checkout.css"></head><body><c:set var="customer" value="${customer}"/><jsp:include page="booking-header.jsp"/>
<main class="ck-wrap"><div class="ck-steps"><span class="done">✓ <b>Chọn vé</b></span><i></i><span class="active">2 <b>Thông tin</b></span><i></i><span>3 <b>Thanh toán</b></span><i></i><span>4 <b>Hoàn tất</b></span></div>
<c:if test="${not empty errorMessage}"><div class="ck-alert"><c:out value="${errorMessage}"/></div></c:if>
<div class="ck-layout"><section class="ck-panel"><p class="ck-eyebrow">BƯỚC 2 / 3</p><h1>Thông tin khách hàng</h1><p class="ck-muted">Thông tin được lấy từ tài khoản Light Ticket của bạn.</p><div class="ck-form-grid"><div class="ck-field"><label>Họ và tên</label><div class="ck-readonly"><c:out value="${customer.fullName}" default="Chưa cập nhật"/></div></div><div class="ck-field"><label>Email</label><div class="ck-readonly"><c:out value="${customer.email}" default="Chưa cập nhật"/></div></div><div class="ck-field"><label>Số điện thoại</label><div class="ck-readonly"><c:out value="${customer.phone}" default="Chưa cập nhật"/></div></div></div><div class="ck-info-note">Kiểm tra thông tin tài khoản trước khi tiếp tục. Nếu cần thay đổi, hãy cập nhật tại trang hồ sơ cá nhân.</div><div class="ck-actions"><a class="ck-button ck-button-secondary" href="${pageContext.request.contextPath}/home">Quay lại</a><a class="ck-button" href="${pageContext.request.contextPath}/booking/payment?orderId=${booking.bookingId}">Tiếp tục thanh toán →</a></div></section>
<aside class="ck-panel ck-summary"><p class="ck-eyebrow">ĐƠN ĐẶT VÉ</p><h2><c:out value="${booking.eventName}"/></h2><p><c:out value="${booking.venueName}"/></p><c:forEach var="item" items="${booking.items}"><div class="ck-summary-row"><span><c:out value="${item.ticketName}"/> × ${item.quantity}</span><strong><fmt:formatNumber value="${item.subtotal}" pattern="#,##0"/> đ</strong></div></c:forEach><c:if test="${not empty booking.seatLabels}"><p class="ck-muted">Ghế: <c:forEach var="seat" items="${booking.seatLabels}" varStatus="loop"><c:if test="${loop.index gt 0}">, </c:if><c:out value="${seat}"/></c:forEach></p></c:if><div class="ck-summary-row"><span>Voucher</span><strong><c:out value="${booking.voucherCode}" default="Không áp dụng"/></strong></div><div class="ck-summary-total"><span>Thành tiền</span><strong><fmt:formatNumber value="${booking.finalAmount}" pattern="#,##0"/> đ</strong></div><div class="ck-countdown" data-expire="${booking.holdExpiredAt}">Thời gian giữ vé: <strong data-countdown>--:--</strong></div></aside></div></main><jsp:include page="booking-footer.jsp"/><script src="${pageContext.request.contextPath}/assets/js/checkout.js"></script></body></html>
