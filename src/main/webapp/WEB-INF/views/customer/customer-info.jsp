<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><fmt:setLocale value="vi_VN"/>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Thông tin khách hàng | Light Ticket</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/checkout.css">    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
    <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/vendor/phosphor/style.css">
    <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/vendor/phosphor/fill.css">
    <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/ui.css">
    <script src="${pageContext.request.contextPath}/assets/js/ui.js" defer></script>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/theme.css?v=20261109">
    <script src="${pageContext.request.contextPath}/assets/js/motion.js?v=20261109" defer></script>
</head><body><c:set var="customer" value="${customer}"/><jsp:include page="booking-header.jsp"/>
<main class="ck-wrap"><div class="ck-steps"><span class="done">✓ <b>Chọn vé</b></span><i></i><span class="active">2 <b>Thông tin</b></span><i></i><span>3 <b>Thanh toán</b></span><i></i><span>4 <b>Hoàn tất</b></span></div>
<c:if test="${not empty errorMessage}"><div class="ck-alert"><c:out value="${errorMessage}"/></div></c:if>
<div class="ck-layout"><section class="ck-panel"><p class="ck-eyebrow">BƯỚC 2 / 3</p><h1>Thông tin khách hàng</h1><p class="ck-muted">Thông tin được lấy từ tài khoản Light Ticket của bạn.</p><form method="post" action="${pageContext.request.contextPath}/booking/customer-info"><input type="hidden" name="orderId" value="${booking.bookingId}"/><div class="ck-form-grid"><div class="ck-field"><label>Họ và tên</label><div class="ck-readonly"><c:out value="${customer.fullName}" default="Chưa cập nhật"/></div></div><div class="ck-field"><label>Email</label><div class="ck-readonly"><c:out value="${customer.email}" default="Chưa cập nhật"/></div></div><div class="ck-field"><label for="phone">Số điện thoại <span style="color:var(--ck-orange)">*</span></label><input class="ck-input" id="phone" name="phone" type="tel" inputmode="numeric" maxlength="11" pattern="0[0-9]{9,10}" required placeholder="VD: 0901234567" title="Bắt đầu bằng 0, gồm 10-11 chữ số" value="<c:out value='${customer.phone}'/>"/></div></div><div class="ck-info-note">Kiểm tra thông tin trước khi tiếp tục. Số điện thoại bạn nhập sẽ được lưu vào hồ sơ; họ tên và email thay đổi tại trang hồ sơ cá nhân.</div><div class="ck-actions"><a class="ck-button ck-button-secondary" href="${pageContext.request.contextPath}/home">Quay lại</a><button class="ck-button" type="submit">Tiếp tục thanh toán →</button></div></form></section>
<aside class="ck-panel ck-summary"><p class="ck-eyebrow">ĐƠN ĐẶT VÉ</p><h2><c:out value="${booking.eventName}"/></h2><p><c:out value="${booking.venueName}"/></p><c:forEach var="item" items="${booking.items}"><div class="ck-summary-row"><span><c:out value="${item.ticketName}"/> × ${item.quantity}</span><strong><fmt:formatNumber value="${item.subtotal}" pattern="#,##0"/> đ</strong></div></c:forEach><c:if test="${not empty booking.seatLabels}"><p class="ck-muted">Ghế: <c:forEach var="seat" items="${booking.seatLabels}" varStatus="loop"><c:if test="${loop.index gt 0}">, </c:if><c:out value="${seat}"/></c:forEach></p></c:if><div class="ck-summary-row"><span>Voucher</span><strong><c:out value="${booking.voucherCode}" default="Không áp dụng"/></strong></div><div class="ck-summary-total"><span>Thành tiền</span><strong><fmt:formatNumber value="${booking.finalAmount}" pattern="#,##0"/> đ</strong></div><div class="ck-countdown" data-expire="${booking.holdExpiredAt}">Thời gian giữ vé: <strong data-countdown>--:--</strong></div></aside></div></main><jsp:include page="booking-footer.jsp"/><script src="${pageContext.request.contextPath}/assets/js/checkout.js"></script></body></html>
