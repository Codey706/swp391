<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><fmt:setLocale value="vi_VN"/>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Thanh toán | Light Ticket</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/checkout.css"></head><body><c:set var="customer" value="${customer}"/><jsp:include page="booking-header.jsp"/>
<main class="ck-wrap"><div class="ck-steps"><span class="done">✓ <b>Chọn vé</b></span><i></i><span class="done">✓ <b>Thông tin</b></span><i></i><span class="active">3 <b>Thanh toán</b></span><i></i><span>4 <b>Hoàn tất</b></span></div>
<c:if test="${not empty errorMessage}"><div class="ck-alert"><c:out value="${errorMessage}"/></div></c:if><c:if test="${not empty paymentMessage}"><div class="ck-info-note"><c:out value="${paymentMessage}"/></div></c:if>
<div class="ck-layout"><section class="ck-panel"><p class="ck-eyebrow">BƯỚC 3 / 3</p><h1>Phương thức thanh toán</h1><p class="ck-muted">Chọn phương thức được hỗ trợ trong phiên bản hiện tại.</p><form method="post" action="${pageContext.request.contextPath}/booking/payment"><input type="hidden" name="orderId" value="${booking.bookingId}"><label class="ck-payment-option selected"><input type="radio" name="paymentMethod" value="VNPAY" checked><span class="ck-payment-icon">V</span><span><strong>VNPay</strong><small>QR, ATM nội địa và thẻ quốc tế qua cổng VNPay</small></span><span class="ck-radio-mark"></span></label><div class="ck-info-note">Bạn sẽ không nhập số thẻ hoặc mã CVV trên Light Ticket. Kết nối chuyển hướng đến cổng VNPay cần được cấu hình riêng; thao tác bên dưới chỉ tạo yêu cầu thanh toán Pending.</div><div class="ck-actions"><a class="ck-button ck-button-secondary" href="${pageContext.request.contextPath}/booking/customer-info?orderId=${booking.bookingId}">Quay lại</a><button class="ck-button" type="submit" <c:if test="${booking.status ne 'Pending'}">disabled</c:if>>Tạo yêu cầu thanh toán · <fmt:formatNumber value="${booking.finalAmount}" pattern="#,##0"/> đ</button></div></form></section>
<aside class="ck-panel ck-summary"><p class="ck-eyebrow">TÓM TẮT ĐƠN HÀNG</p><h2><c:out value="${booking.eventName}"/></h2><p><c:out value="${booking.venueName}"/></p><c:forEach var="item" items="${booking.items}"><div class="ck-summary-row"><span><c:out value="${item.ticketName}"/> × ${item.quantity}</span><strong><fmt:formatNumber value="${item.subtotal}" pattern="#,##0"/> đ</strong></div></c:forEach><div class="ck-summary-row"><span>Tạm tính</span><strong><fmt:formatNumber value="${booking.totalAmount}" pattern="#,##0"/> đ</strong></div><div class="ck-summary-row"><span>Giảm giá</span><strong>− <fmt:formatNumber value="${booking.discountAmount}" pattern="#,##0"/> đ</strong></div><div class="ck-summary-total"><span>Tổng thanh toán</span><strong><fmt:formatNumber value="${booking.finalAmount}" pattern="#,##0"/> đ</strong></div><div class="ck-countdown" data-expire="${booking.holdExpiredAt}">Thời gian giữ vé: <strong data-countdown>--:--</strong></div><p class="ck-note">Nếu hết thời gian giữ vé, đơn sẽ bị hủy và số lượng vé được hoàn lại.</p></aside></div></main><jsp:include page="booking-footer.jsp"/><script src="${pageContext.request.contextPath}/assets/js/checkout.js"></script></body></html>
