<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><fmt:setLocale value="vi_VN"/>
<c:if test="${not empty event.startTime}"><fmt:parseDate value="${fn:substring(event.startTime, 0, 16)}" pattern="yyyy-MM-dd'T'HH:mm" var="startDate" type="both"/><fmt:formatDate value="${startDate}" pattern="HH:mm, dd/MM/yyyy" var="startText"/></c:if>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Chọn vé | Light Ticket</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/checkout.css"></head><body>
<c:set var="customer" value="${sessionScope.user}"/><jsp:include page="booking-header.jsp"/>
<main class="ck-wrap"><div class="ck-steps"><span class="active">1 <b>Chọn vé</b></span><i></i><span>2 <b>Thông tin</b></span><i></i><span>3 <b>Thanh toán</b></span><i></i><span>4 <b>Hoàn tất</b></span></div>
<c:if test="${not empty errorMessage}"><div class="ck-alert"><c:out value="${errorMessage}"/></div></c:if>
<section class="ck-event-hero"><div class="ck-event-image"><c:if test="${not empty event.eventImage}"><img src="${pageContext.request.contextPath}/${event.eventImage}" alt="Ảnh sự kiện" onerror="this.remove();"></c:if><c:if test="${empty event.eventImage}"><span>LIGHT TICKET</span></c:if></div><div><p class="ck-eyebrow">ĐẶT VÉ SỰ KIỆN</p><h1><c:out value="${event.eventName}"/></h1><p><c:out value="${event.venueName}"/></p><p><c:out value="${startText}"/></p><p class="ck-muted"><c:out value="${event.description}"/></p></div></section>
<form method="post" action="${pageContext.request.contextPath}/booking/select-ticket" id="ticketForm" data-max-tickets="${maxTickets}"><input type="hidden" name="eventId" value="${event.eventId}">
<div class="ck-layout"><section class="ck-panel"><div class="ck-panel-title"><div><p class="ck-eyebrow">BƯỚC 1 / 3</p><h2>Chọn loại vé</h2></div><span class="ck-muted">Tối đa ${maxTickets} vé/đơn</span></div>
<c:choose><c:when test="${empty tickets}"><p>Hiện chưa có loại vé mở bán cho sự kiện này.</p></c:when><c:otherwise><c:forEach var="ticket" items="${tickets}"><fmt:formatNumber value="${ticket.price}" pattern="0" var="rawPrice"/><c:set var="soldOut" value="${ticket.availableQuantity le 0}"/><c:set var="picked" value="${empty selectedQty[ticket.eventTicketId] ? 0 : selectedQty[ticket.eventTicketId]}"/><article class="ck-ticket"><div class="ck-ticket-info"><h3><c:out value="${ticket.ticketName}"/></h3><p><c:out value="${ticket.description}"/></p><small><c:choose><c:when test="${soldOut}">Hết vé</c:when><c:otherwise>Còn ${ticket.availableQuantity} vé</c:otherwise></c:choose></small></div><div class="ck-ticket-buy"><strong><fmt:formatNumber value="${ticket.price}" pattern="#,##0"/> đ</strong><div class="ck-quantity"><button type="button" data-change="-1" aria-label="Giảm" <c:if test="${soldOut}">disabled</c:if>>−</button><input name="quantity_${ticket.eventTicketId}" type="number" min="0" max="${ticket.availableQuantity}" value="${soldOut ? 0 : picked}" data-qty data-price="${rawPrice}" <c:if test="${soldOut}">disabled</c:if>><button type="button" data-change="1" aria-label="Tăng" <c:if test="${soldOut}">disabled</c:if>>+</button></div></div></article></c:forEach></c:otherwise></c:choose>
<c:if test="${hasSeats}"><div class="ck-panel-title ck-seat-heading"><div><p class="ck-eyebrow">TÙY CHỌN</p><h2>Chọn ghế</h2></div><span class="ck-muted">Nếu chọn ghế, số ghế phải bằng số vé</span></div><div class="ck-seat-list"><c:forEach var="seat" items="${seats}"><label class="ck-seat <c:if test="${seat.status ne 'Available'}">disabled</c:if>"><input type="checkbox" name="seatIds" value="${seat.eventSeatId}" <c:if test="${seat.status ne 'Available'}">disabled</c:if> <c:if test="${seat.status eq 'Available' and not empty selectedSeatIds and selectedSeatIds.contains(seat.eventSeatId)}">checked</c:if>><span><c:out value="${seat.seatLabel}"/></span></label></c:forEach></div></c:if>
<div class="ck-voucher"><label for="voucherCode">Mã voucher (nếu có)</label><input id="voucherCode" name="voucherCode" maxlength="50" placeholder="Nhập mã voucher" value="<c:out value='${voucherValue}'/>"></div>
</section><aside class="ck-panel ck-summary"><p class="ck-eyebrow">TÓM TẮT ĐƠN HÀNG</p><h2>Thông tin vé</h2><div class="ck-summary-row"><span>Số lượng</span><strong id="totalQty">0 vé</strong></div><div class="ck-summary-row"><span>Tạm tính</span><strong id="totalPrice">0 đ</strong></div><div class="ck-summary-row"><span>Phí dịch vụ</span><strong>0 đ</strong></div><div class="ck-summary-total"><span>Tổng cộng</span><strong id="grandTotal">0 đ</strong></div><button class="ck-button" type="submit">Tiếp tục <span>→</span></button><p class="ck-note">Sau khi bạn bấm Tiếp tục, vé và ghế được giữ trong 10 phút để hoàn tất thanh toán.</p></aside></div></form><div class="ck-mobile-cta"><strong id="mobileGrandTotal">0 đ</strong><button class="ck-button" type="submit" form="ticketForm">Tiếp tục →</button></div></main><jsp:include page="booking-footer.jsp"/><script src="${pageContext.request.contextPath}/assets/js/checkout.js"></script></body></html>
